TESSERACT_HTTP_ADDRESS=127.0.0.1:8080
TESSERACT_DB_PORT=5433
TESSERACT_DB_PASSWORD=tesseract-local-only
# Application state and schema metadata only. URL query options are rejected.
TESSERACT_DATABASE_URL=postgres://tesseract:tesseract-local-only@localhost:5433/tesseract
# Local development only; use verify-full and PGSSLROOTCERT in production.
PGSSLMODE=disable

# Optional SQL Server profile: local development administration only.
TESSERACT_MSSQL_PORT=1433
TESSERACT_MSSQL_SA_PASSWORD=Tesseract-Local-Only-2026!
# Dedicated SELECT-only DWH user; db_denydatawriter membership required. See README.
TESSERACT_DWH_CRM_DSN=

TESSERACT_METADATA_MAX_AGE=15m

# Exact browser origin. Production requires HTTPS and secure cookies.
TESSERACT_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Local loopback HTTP only; leave false/unset in production.
TESSERACT_AUTH_INSECURE_DEVELOPMENT=true

# Optional OIDC. Redirect must equal PUBLIC_ORIGIN + /api/v1/auth/oidc/callback.
TESSERACT_OIDC_ENABLED=false
TESSERACT_OIDC_ISSUER=
TESSERACT_OIDC_DISCOVERY_URL=
TESSERACT_OIDC_CLIENT_ID=
TESSERACT_OIDC_CLIENT_SECRET=
TESSERACT_OIDC_REDIRECT_URI=
TESSERACT_OIDC_SCOPES="openid email profile"
